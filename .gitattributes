# Normalise line endings in the repository to LF.
#
# The team works on Windows but the containers run Linux. Without this, shell
# scripts and config files committed with CRLF fail inside the images with
# confusing "not found" errors.
* text=auto eol=lf

# Files that must be LF regardless of platform
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
*.env       text eol=lf

# Binary — never touch
*.xlsx  binary
*.XLSX  binary
*.docx  binary
*.png   binary
*.jpg   binary
*.pdf   binary
