    "helmet": "8.0.0",
    "jose": "5.9.6",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^10.5.0",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "redis": "4.7.0",
    "xlsx": "file:../vendor/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
