# Local development configuration.
# Every variable is validated at boot; the process exits on anything invalid.

NODE_ENV=development
APP_BASE_URL=http://localhost:8081
PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info

# ── Session ─────────────────────────────────────────────────────────────
# This app's own key, unrelated to the DWS Hub. Regenerate for any shared use:
#   openssl rand -base64 48
SESSION_SECRET=local-development-only-change-me-0123456789abcdefghijklmnop
SESSION_COOKIE_NAME=pct_sid
SESSION_COOKIE_SAMESITE=Lax
# false is correct here: single origin over plain HTTP. In production this must
# be true, and boot validation enforces it.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MIN=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ── Local accounts ──────────────────────────────────────────────────────
# The DWS Hub is unreachable from a laptop, so local auth is the login path here.
# Both SSO flows must still be exercised against staging before any auth change.
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_REQUIRE_MFA=false
LOCAL_AUTH_MAX_ATTEMPTS=5
LOCAL_AUTH_LOCKOUT_MIN=15

# ── DWS Hub OIDC ────────────────────────────────────────────────────────
# Left unset locally. OIDC is all-or-nothing: setting only some of these fails
# at boot rather than producing a 404 login route that is harder to diagnose.
# OIDC_DISCOVERY_URL=https://<hub-host>/api/sso/.well-known/openid-configuration
# OIDC_CLIENT_ID=procurement-control-tower
# OIDC_REDIRECT_URI=http://localhost:8080/auth/oidc/callback
OIDC_SCOPES=openid email profile

# ── Data ────────────────────────────────────────────────────────────────
DB_POOL_MAX=10
DATASET_VERSIONS_RETAINED=4

# ── Ingestion ───────────────────────────────────────────────────────────
# ── Shared Synology NAS (Docs/SYNOLOGY-INTEGRATION.md) ──────────────────
# A laptop has no NAS mount, so no STORAGE_* variable is set here and the app
# falls back to SHARE_PATH below — the doc is explicit that Option B must not
# be used without the mount. To rehearse the server layout locally, bind a
# folder at /mnt/synology/eos in docker-compose.yml and set the three Option B
# variables; the Admin panel then reports whether the bind really happened.

SHARE_PATH=/mnt/sap_exports
SHARE_POLL_CRON_MINUTES=30
UPLOAD_SPOOL_PATH=/var/lib/pct/spool
UPLOAD_MAX_FILE_MB=60
UPLOAD_MAX_BATCH_MB=200
INGEST_FILE_SETTLE_SECONDS=5
INGEST_STALL_CYCLES=4
# Off by default locally so an ingest only runs when you ask for one.
INGEST_AUTOPOLL_ENABLED=false

# ── Notifications ───────────────────────────────────────────────────────
SMTP_SECURE=none
SMTP_FROM=Procurement Control Tower <pct-notify@energi-up.com>
NOTIFY_RATE_LIMIT_PER_HOUR=20
NOTIFY_ENABLED=true
