# Coupa credentials for staging — copy to the BE server as
# /opt/pct/secrets.staging.env and fill in. NEVER commit the filled file.
# Without this file the stack still runs; Coupa integrations stay off.
COUPA_BASE_URL=https://kpn-test.coupahost.com
COUPA_CLIENT_ID=<staging client id>
COUPA_CLIENT_SECRET=<staging client secret>
