# Coupa credentials for staging — copy to the BE server as
# /opt/pct/secrets.staging.env and fill in. NEVER commit the filled file.
# Without this file the stack still runs; Coupa integrations stay off.
COUPA_BASE_URL=https://kpn-test.coupahost.com
COUPA_CLIENT_ID=<staging client id>
COUPA_CLIENT_SECRET=<staging client secret>

# Data Hub Management (DHM) - exchange rates (040). The key pair comes from the
# DHM System Integrator (portal /integrations), registered for PCT with
# `exchange_rate` on its allowlist. Without these, FX falls back to the SAP
# rate file only.
DHM_BASE_URL=http://test-datahub.kpndomain.com/api
DHM_PUBLIC_KEY=<dhm_pk_... from the integrator>
DHM_PRIVATE_KEY=<dhm_sk_... from the integrator>
