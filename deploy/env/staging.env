# Staging configuration (172.28.92.56 / .57 / .60) — template.
# Copy to the BE server as /opt/pct/staging.env and fill every <PLACEHOLDER>.
# Every variable is validated at boot; the process exits on anything invalid.

# NOTE: staging runs over plain HTTP inside the VPC, so the cookie must not be
# Secure — and boot validation (correctly) refuses NODE_ENV=production with an
# insecure cookie. Staging therefore runs in development mode until it gets
# TLS. This also lets the dev admin seed run (db/seed.js).
NODE_ENV=development
APP_BASE_URL=http://172.28.92.56:3050
PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info

# ── Session ─────────────────────────────────────────────────────────────
# Generate a fresh one for staging:  openssl rand -base64 48
SESSION_SECRET=<RUN openssl rand -base64 48 AND PASTE HERE>
SESSION_COOKIE_NAME=pct_sid
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MIN=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ── Local accounts ──────────────────────────────────────────────────────
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_REQUIRE_MFA=false
LOCAL_AUTH_MAX_ATTEMPTS=5
LOCAL_AUTH_LOCKOUT_MIN=15

# ── DWS Hub OIDC (SSO) ──────────────────────────────────────────────────
# All-or-nothing: set all three or none (boot validation enforces it).
# 1. Register the app in the Hub (Admin -> Applications):
#      redirect URI  http://172.28.92.56:3050/auth/oidc/callback   (byte-exact)
#      client type   public / PKCE (no client secret exists)
# 2. Put the Hub's real hostname + the assigned client_id here.
# 3. Verify FROM THE BE SERVER:  curl -s <discovery url>   (backend does the
#    token exchange server-to-server; browser reachability is not enough).
# While the Hub is unreachable the login page simply hides the SSO button;
# local credentials keep working either way.
# OIDC_DISCOVERY_URL=https://<hub-host>/api/sso/.well-known/openid-configuration
# OIDC_CLIENT_ID=<client id assigned by the Hub admin>
# OIDC_REDIRECT_URI=http://172.28.92.56:3050/auth/oidc/callback
OIDC_SCOPES=openid email profile

# ── Data ────────────────────────────────────────────────────────────────
# Password = POSTGRES_PASSWORD from the DB server's /opt/pct/db.env.
DATABASE_URL=postgres://pct:<DB_PASSWORD>@172.28.92.60:5436/pct
DB_POOL_MAX=10
DATASET_VERSIONS_RETAINED=4

# ── Shared Synology NAS (Docs/SYNOLOGY-INTEGRATION.md) ──────────────────
# Where the six SAP exports are read from. Mounted READ-ONLY: this app only
# reads them.
#
# UNCOMMENT THESE FOUR LINES ONLY AFTER the mount check in DEPLOY_STAGING.md
# passes on the BE server, i.e. `findmnt /mnt/synology-apps` shows a REAL cifs
# mount (checked 7 Aug 2026: it did NOT - the folders exist but are local
# ext4 directories, so the share was never mounted on this VM). While they stay
# commented the app reads assets/ through SHARE_PATH exactly as before, so a
# missing mount cannot take staging down — and Admin -> SAP Data Upload shows
# which of the two is in effect.
#
# Docker will happily bind a NON-EXISTENT host path as an empty folder, so
# "uncommented but not mounted" looks like "no files found". The API detects
# that case at boot (WARNING storage: ...) and the Admin panel names it.
#
# STORAGE_TYPE=local
# STORAGE_SYNOLOGY_ROOT=/mnt/synology-apps
# STORAGE_DEPLOYMENT=dev
# STORAGE_PROJECT_SLUG=pct
#
# Resolved folder: /mnt/synology-apps/dev/pct  (File Station: APPs -> dev -> pct)
# All three must be set together or none — boot validation refuses a partial
# set, because falling back silently means a dashboard that reads the wrong
# folder while looking perfectly healthy. STORAGE_PROJECT_SLUG must match the
# folder infra created for this app; ask them only if that folder is missing.
#
# The HOST path is substituted by Compose, not by this file: set
# STORAGE_HOST_MOUNT in /opt/pct/.env next to be.compose.yml if the NAS is
# mounted somewhere other than /mnt/synology-apps.

# ── Ingestion ───────────────────────────────────────────────────────────
# Fallback source, used while the STORAGE_* block above is commented out.
# NOTE: be.compose.yml pins SHARE_PATH in its `environment:` block, which
# overrides this file — change it there, not here.
SHARE_PATH=/mnt/sap_exports
SHARE_POLL_CRON_MINUTES=30
UPLOAD_SPOOL_PATH=/var/lib/pct/spool
UPLOAD_MAX_FILE_MB=60
UPLOAD_MAX_BATCH_MB=200
INGEST_FILE_SETTLE_SECONDS=5
INGEST_STALL_CYCLES=4
# On for staging: new files dropped into the share are picked up on the cron.
INGEST_AUTOPOLL_ENABLED=true

# ── Notifications (email) ───────────────────────────────────────────────
# Scheduled-run notifications. Recipients and which events fire are set in
# Admin -> Notifications; only the server and its credentials live here.
NOTIFY_ENABLED=true
SMTP_HOST=mail.energi-up.com
# PORT 465, NOT 587 — tested against the live server on 6 Aug 2026:
#   587 advertises only "AUTH PLAIN LOGIN CRAM-MD5" and answers STARTTLS with
#       "503 TLS is not allowed", so a session there is unencrypted.
#   465 accepts implicit TLS AND passes full certificate verification (the cert
#       names mail.cemindo.com in its CN but covers this host via a SAN).
# So 465 is both the working and the secure choice; 'tls' selects implicit TLS.
SMTP_PORT=465
SMTP_SECURE=tls
SMTP_USER=noreply.sys@energi-up.com
# Fill this in ON THE SERVER — this file is tracked in git, so a real password
# here would be published on the next commit.
SMTP_PASSWORD=<SMTP password for noreply.sys@energi-up.com>
SMTP_FROM=Procurement Control Tower <noreply.sys@energi-up.com>
NOTIFY_RATE_LIMIT_PER_HOUR=20
