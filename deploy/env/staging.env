# Staging configuration (172.28.92.56 / .57 / .60) — template.
# Copy to the BE server as /opt/pct/staging.env and fill every <PLACEHOLDER>.
# Every variable is validated at boot; the process exits on anything invalid.

# NOTE: staging runs over plain HTTP inside the VPC, so the cookie must not be
# Secure — and boot validation (correctly) refuses NODE_ENV=production with an
# insecure cookie. Staging therefore runs in development mode until it gets
# TLS. This also lets the dev admin seed run (db/seed.js).
NODE_ENV=development
APP_BASE_URL=http://172.28.92.56:3050
PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info

# ── Session ─────────────────────────────────────────────────────────────
# Generate a fresh one for staging:  openssl rand -base64 48
SESSION_SECRET=<RUN openssl rand -base64 48 AND PASTE HERE>
SESSION_COOKIE_NAME=pct_sid
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MIN=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ── Local accounts ──────────────────────────────────────────────────────
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_REQUIRE_MFA=false
LOCAL_AUTH_MAX_ATTEMPTS=5
LOCAL_AUTH_LOCKOUT_MIN=15

# ── DWS Hub OIDC (SSO) ──────────────────────────────────────────────────
# All-or-nothing: set all three or none (boot validation enforces it).
# 1. Register the app in the Hub (Admin -> Applications):
#      redirect URI  http://172.28.92.56:3050/auth/oidc/callback   (byte-exact)
#      client type   public / PKCE (no client secret exists)
# 2. Put the Hub's real hostname + the assigned client_id here.
# 3. Verify FROM THE BE SERVER:  curl -s <discovery url>   (backend does the
#    token exchange server-to-server; browser reachability is not enough).
# While the Hub is unreachable the login page simply hides the SSO button;
# local credentials keep working either way.
# OIDC_DISCOVERY_URL=https://<hub-host>/api/sso/.well-known/openid-configuration
# OIDC_CLIENT_ID=<client id assigned by the Hub admin>
# OIDC_REDIRECT_URI=http://172.28.92.56:3050/auth/oidc/callback
OIDC_SCOPES=openid email profile

# ── Data ────────────────────────────────────────────────────────────────
# Password = POSTGRES_PASSWORD from the DB server's /opt/pct/db.env.
DATABASE_URL=postgres://pct:<DB_PASSWORD>@172.28.92.60:5436/pct
DB_POOL_MAX=10
DATASET_VERSIONS_RETAINED=4

# ── Ingestion ───────────────────────────────────────────────────────────
SHARE_PATH=/mnt/sap_exports
SHARE_POLL_CRON_MINUTES=30
UPLOAD_SPOOL_PATH=/var/lib/pct/spool
UPLOAD_MAX_FILE_MB=60
UPLOAD_MAX_BATCH_MB=200
INGEST_FILE_SETTLE_SECONDS=5
INGEST_STALL_CYCLES=4
# On for staging: new files dropped into the share are picked up on the cron.
INGEST_AUTOPOLL_ENABLED=true

# ── Notifications ───────────────────────────────────────────────────────
# No mailhog on staging; point at a real relay or leave disabled.
NOTIFY_ENABLED=false
SMTP_SECURE=none
SMTP_FROM=Procurement Control Tower <pct-notify@energi-up.com>
NOTIFY_RATE_LIMIT_PER_HOUR=20
