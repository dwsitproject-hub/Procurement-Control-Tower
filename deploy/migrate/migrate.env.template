# Connection values for the staging DB -> ApsaraDB RDS migration.
#
# Copy to the BE server as /opt/pct/migrate/migrate.env, fill the two passwords,
# then:  chmod 600 /opt/pct/migrate/migrate.env
#
# NEVER commit a filled copy. Read each value from the file that already holds
# it rather than retyping it:
#   SRC_PASSWORD  = POSTGRES_PASSWORD in /opt/pct/db.env on the DB server
#                   (172.28.92.60), or the password already inside
#                   DATABASE_URL in /opt/pct/staging.env on this server.
#   DST_PASSWORD  = the ApsaraDB account password, from the RDS console.

# ── Source: the container-hosted staging database ───────────────────────
SRC_HOST=172.28.92.60
SRC_PORT=5436
SRC_DB=pct
SRC_USER=pct
SRC_PASSWORD=

# ── Destination: ApsaraDB RDS for PostgreSQL, staging ───────────────────
DST_HOST=pgm-d9jx9o06qae8gf3h.pgsql.ap-southeast-5.rds.aliyuncs.com
DST_PORT=5432
DST_DB=pct
DST_USER=
DST_PASSWORD=

# Where dumps, baselines and reports are written. Needs ~1 GB free; the
# staging dump measured 116 MB locally and grows with each retained version.
WORKDIR=/opt/pct/migrate
