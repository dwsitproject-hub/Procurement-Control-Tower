# Frontend build settings for production - copy to the FE server as
# /opt/pct/fe-build.env. The Downstream Hub SDK key is PUBLISHABLE (it is in the
# page source by design), so this is configuration, not a secret.
# Docs/HUB_SDK_AND_SENTINEL.md. Delete both lines to build without the SDK.
HUB_SDK_URL=https://dwshub.kpndomain.com
HUB_SDK_KEY=FILL_FROM_THE_PRODUCTION_HUB
