# Production configuration (FE 172.28.80.50 / BE 172.28.80.51 / ApsaraDB) - template.
# Copy to the BE server as /opt/pct/production.env and fill the values marked
# FILL ON THE SERVER. Every variable is validated at boot; the API exits on
# anything invalid. NEVER commit a filled copy. Guide: Docs/DEPLOY_PRODUCTION.md.

# ── Mode ───────────────────────────────────────────────────────────────────
# `staging`, NOT `production`, while pct.kpndomain.com is plain HTTP.
# NODE_ENV=production demands SESSION_COOKIE_SECURE=true, which browsers only
# honour over HTTPS, and refuses local sign-in without MFA, which PCT does not
# implement - so production mode needs TLS AND SSO-only sign-in first
# (guide: "Going to HTTPS"). `staging` runs the same code with those two checks
# relaxed; the development admin is NOT seeded in this mode.
NODE_ENV=staging
APP_BASE_URL=http://pct.kpndomain.com
PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info

# ── Session ────────────────────────────────────────────────────────────────
# FILL ON THE SERVER:  openssl rand -base64 48   (a NEW value - never staging's)
SESSION_SECRET=FILL_ON_THE_SERVER
SESSION_COOKIE_NAME=pct_sid
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MIN=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ── Local accounts ─────────────────────────────────────────────────────────
# On until SSO works and TLS is in place; the first admin is created with
#   docker exec -it pct-api node dist/cli/set-password.js --email ... --create-admin --name "..."
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_REQUIRE_MFA=false
LOCAL_AUTH_MAX_ATTEMPTS=5
LOCAL_AUTH_LOCKOUT_MIN=15

# ── DWS Hub OIDC (SSO) - production Hub ────────────────────────────────────
# All three or none. Register PCT in the PRODUCTION Hub (Admin -> Applications):
# redirect URI exactly http://pct.kpndomain.com/auth/oidc/callback, public/PKCE.
# Check from THIS server first:
#   curl -s -o /dev/null -w '%{http_code}\n' https://dwshub.kpndomain.com/api/sso/.well-known/openid-configuration
# OIDC_DISCOVERY_URL=https://dwshub.kpndomain.com/api/sso/.well-known/openid-configuration
# OIDC_CLIENT_ID=FILL_FROM_THE_HUB
# OIDC_REDIRECT_URI=http://pct.kpndomain.com/auth/oidc/callback
OIDC_SCOPES=openid email profile

# ── Data: ApsaraDB RDS for PostgreSQL (production) ─────────────────────────
# A dedicated account `pct` that OWNS the database `pct` - not the instance's
# privileged account (guide step 3). A URI, so percent-encode any of
# : / ? # [ ] @ & = + or space in the password: an unencoded '@' silently moves
# the hostname.
DATABASE_URL=postgres://pct:FILL_ON_THE_SERVER@pgm-d9jn3khh0b3907w4.pgsql.ap-southeast-5.rds.aliyuncs.com:5432/pct
DB_POOL_MAX=10
DATASET_VERSIONS_RETAINED=6

# ── Synology NAS: PCT's own folder, APPs/PCT ───────────────────────────────
# Mounted on the host at /mnt/pct-nas (guide step 5) and bound at the same path.
# An explicit path, because production folders sit at the share ROOT (APPs/PCT)
# and the composed root/deployment/slug form would add a 'prod' folder.
# STORAGE_EXPECT_MOUNT=true keeps the boot check that the path really is the
# NAS: Docker silently creates an empty folder when a bind source is missing.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/mnt/pct-nas
STORAGE_EXPECT_MOUNT=true

# ── Ingestion ──────────────────────────────────────────────────────────────
SHARE_PATH=/mnt/pct-nas
UPLOAD_SPOOL_PATH=/var/lib/pct/spool
UPLOAD_MAX_FILE_MB=60
UPLOAD_MAX_BATCH_MB=200
INGEST_FILE_SETTLE_SECONDS=5
INGEST_STALL_CYCLES=4
# The scheduled pickup is switched on in the app (Admin -> SAP Data Upload ->
# SAP Data Sync), not here.

# ── Notifications (email) ──────────────────────────────────────────────────
# Port 465 with implicit TLS - 587 offers no STARTTLS on this server.
NOTIFY_ENABLED=true
SMTP_HOST=mail.energi-up.com
SMTP_PORT=465
SMTP_SECURE=tls
SMTP_USER=noreply.sys@energi-up.com
# FILL ON THE SERVER (this file is tracked in git as a template).
SMTP_PASSWORD=FILL_ON_THE_SERVER
SMTP_FROM=Procurement Control Tower <noreply.sys@energi-up.com>
SMTP_REJECT_UNAUTHORIZED=true
NOTIFY_RATE_LIMIT_PER_HOUR=20
