# Production integration credentials - copy to the BE server as
# /opt/pct/secrets.production.env, fill in ON THE SERVER, chmod 600.
# NEVER commit the filled file. Without it the stack runs; the integrations stay off.

# Coupa (production tenant). The OAuth client comes from the Coupa admin.
COUPA_BASE_URL=https://kpn.coupahost.com
COUPA_CLIENT_ID=FILL_ON_THE_SERVER
COUPA_CLIENT_SECRET=FILL_ON_THE_SERVER

# Data Hub Management - exchange rates (modules/dhm). A PCT application with
# `exchange_rate` on its allowlist, registered by the PRODUCTION Data Hub's
# integrator. Leave all three out to take rates from the SAP file only.
# DHM_BASE_URL=FILL_THE_PRODUCTION_DATA_HUB_API_ROOT
# DHM_PUBLIC_KEY=FILL_ON_THE_SERVER
# DHM_PRIVATE_KEY=FILL_ON_THE_SERVER
